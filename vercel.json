{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "functions": {
    "api/rooms.mjs": {
      "includeFiles": "*.json",
      "regions": [
        "sin1"
      ]
    },
    "api/leaderboard.mjs": {
      "regions": [
        "sin1"
      ]
    },
    "api/account.mjs": {
      "regions": [
        "sin1"
      ]
    }
  },
  "rewrites": [
    {"source": "/get-extension", "destination": "/extension.html"},
    {"source": "/pocket", "destination": "/pocket.html"},
    {
      "source": "/api/rooms/:code/:action",
      "destination": "/api/rooms?code=:code&action=:action"
    },
    {
      "source": "/api/rooms/:code",
      "destination": "/api/rooms?code=:code"
    }
  ],
  "headers": [
    {"source": "/downloads/packet-party-pocket-search.zip", "headers": [{"key": "Content-Disposition", "value": "attachment; filename=packet-party-pocket-search.zip"}]},
    {"source": "/downloads/packet-party-pocket-search-store.zip", "headers": [{"key": "Content-Disposition", "value": "attachment; filename=packet-party-pocket-search-store.zip"}]}
  ]
}
